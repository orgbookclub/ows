{
  "name": "ows",
  "author": "ravsodhi",
  "version": "3.2.1",
  "description": "Web Server",
  "main": "./dist/main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "keywords": [
    "nestjs",
    "orgbookclub"
  ],
  "repository": "https://github.com/orgbookclub/ows",
  "bugs": {
    "url": "https://github.com/orgbookclub/ows/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0 --fix",
    "openapi:generate": "rimraf client && openapi-generator-cli generate --generator-key v0.1.0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev:token": "bash scripts/dev-token.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/axios": "^4",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11",
    "@nestjs/mongoose": "^11",
    "@nestjs/passport": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@opentelemetry/api-logs": "^0.217.0",
    "applicationinsights": "^3",
    "argon2": "^0.44.0",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "domhandler": "^5",
    "mongoose": "^8.23.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.0",
    "passport-oauth2-client-password": "^0.1.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.2",
    "@types/passport-http": "^0.3.11",
    "@types/passport-jwt": "^4",
    "@types/passport-oauth2-client-password": "^0.1.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2.31",
    "eslint-plugin-jsdoc": "^50",
    "eslint-plugin-prettier": "^5.2",
    "globals": "^15",
    "jest": "^29.5.0",
    "mongodb": "^7",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
