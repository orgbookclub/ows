{
  "name": "ows",
  "author": "ravsodhi",
  "version": "0.3.0",
  "description": "Web Server",
  "main": "./dist/main.js",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "nestjs",
    "orgbookclub"
  ],
  "repository": "https://github.com/orgbookclub/ows",
  "bugs": {
    "url": "https://github.com/orgbookclub/ows/issues"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "openapi:generate": "rimraf client && openapi-generator-cli generate --generator-key v0.1.0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^9.4.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^9.4.2",
    "@nestjs/jwt": "^10.0.3",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-express": "^9.4.2",
    "@nestjs/swagger": "^6.3.0",
    "@sentry/node": "^7.46.0",
    "@sentry/tracing": "^7.56.0",
    "axios": "^1.4.0",
    "cheerio": "^1.0.0-rc.12",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "passport": "^0.6.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.0",
    "passport-oauth2-client-password": "^0.1.2",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.3.0",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^9.4.0",
    "@openapitools/openapi-generator-cli": "^2.5.2",
    "@types/express": "^4.17.15",
    "@types/jest": "29.5.0",
    "@types/node": "^20.3.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/passport-http": "^0.3.9",
    "@types/passport-jwt": "^3.0.7",
    "@types/passport-oauth2-client-password": "^0.1.2",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.7",
    "dotenv": "^16.0.3",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^40.1.1",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "mongodb": "^5.1.0",
    "path": "^0.12.7",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=18.0.0 < 19.0.0",
    "yarn": ">=1.2.0 < 2.0.0"
  }
}
