MONGODB_URI=
ENV=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Run `yarn ts-node scripts/generate-jwt-keypair.ts` to generate a fresh
# RS256 keypair. PEM newlines may be encoded as \n on a single line.
PRIVATE_KEY_PEM=
PUBLIC_KEY_PEM=

# Path to the registered-clients catalogue, resolved relative to the
# working directory if the path is relative. The default file
# (`config/clients.json`) ships empty so production never accidentally
# accepts the well-known dev client. For local development, point this
# at the committed `config/clients.dev.json`, which contains a single
# `dev` client (secret: `dev-secret`, scope: `*`).
CLIENTS_FILE=config/clients.dev.json
