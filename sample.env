MONGODB_URI=
ENV=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Run `yarn ts-node scripts/generate-jwt-keypair.ts` to generate a fresh
# RS256 keypair. PEM newlines may be encoded as \n on a single line.
PRIVATE_KEY_PEM=
PUBLIC_KEY_PEM=

# Optional: override the path to the registered-clients catalogue.
# Defaults to `config/clients.json`, resolved relative to the working
# directory if the path is relative.
CLIENTS_FILE=
